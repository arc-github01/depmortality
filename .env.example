# Copy to .env (git-ignored) and fill in. Never commit real values.
GITHUB_TOKEN=
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
# Secret salt for hashing maintainer identities. Any long random string; keep it stable
# for the life of a data snapshot, and never publish it.
DEPMORTALITY_ID_SALT=
# BigQuery dataset in your project that holds the slim GH Archive extraction.
DEPMORTALITY_BQ_DATASET=depmortality
